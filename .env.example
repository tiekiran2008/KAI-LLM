# ============================================================
# KAI-LLM V3 — environment configuration
# ============================================================
# Copy this file to ".env" in the project root and fill in real
# values. NEVER commit ".env" (it is gitignored).


# --- LLM mode ---------------------------------------------------
# One of: mock | openai_endpoint | local_adapter
#   mock            -> deterministic fake LLM (tests / offline dev)
#   openai_endpoint -> any OpenAI-compatible server (Ollama, vLLM, ...)
#   local_adapter   -> Qwen2.5-1.5B-Instruct + trained LoRA adapter
KAI_API_MODE=mock


# --- openai_endpoint settings (only used when mode=openai_endpoint) ---
KAI_ENDPOINT_BASE_URL=
KAI_ENDPOINT_MODEL=
KAI_ENDPOINT_API_KEY=
KAI_ENDPOINT_TIMEOUT=30


# --- local_adapter / KAI-LLM V3 ---------------------------------
# Path to the trained LoRA adapter directory. Leave commented to use
# the default (project_root/qlora_output_kai). The adapter is NOT
# bundled in this repository; download it from:
#   https://huggingface.co/kiran2008/KAI-LLM-v3
# The API NEVER silently substitutes the base Qwen model if the
# adapter is missing.
#KAI_ADAPTER_PATH=D:\KAI-LLM\qlora_output_kai


# --- RAG (Retrieval-Augmented Generation) -----------------------
KAI_RAG_ENABLED=1
#KAI_RAG_PERSIST_DIR=D:\KAI-LLM\rag\chroma_db


# --- File inspection tool (read-only) ---------------------------
# Directory the agent is allowed to list/read. Empty = tool disabled.
KAI_WORKSPACE_DIR=


# --- Supabase long-term memory (optional) -----------------------
# Without these, /memories endpoints return 503 and the agent runs
# without memory search. Create a project at https://supabase.com,
# then run memory/sql/001_create_memories.sql in the SQL editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER ONLY. Never put this in frontend code or client bundles.
# Not required for normal memory operations.
SUPABASE_SERVICE_ROLE_KEY=
