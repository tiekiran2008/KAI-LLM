# Copy to D:\KAI-LLM\.env and fill in real values.
# Never commit .env (already gitignored).

# Supabase project URL (Settings -> API)
SUPABASE_URL=

# Anon/public key — used for user-scoped memory ops (RLS enforced)
SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never put in frontend code.
# Not required for normal memory operations; leave empty unless you
# know why you need it.
SUPABASE_SERVICE_ROLE_KEY=
